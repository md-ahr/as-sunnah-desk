{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./src/test/mocks/server-only.ts"]
    }
  },
  "include": [
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "src/test/**/*.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
